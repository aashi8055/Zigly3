<resources>
    <!--
      The splash ground.

      The same white as COLORS.ground / COLORS.white in
      ../../../../../../src/constants/appConstants.ts, and the same white the
      store itself paints. That agreement is the whole point: this window
      background, the JS splash that replaces it, the app's own ground and the
      page behind it are one continuous white, so nothing about the hand-off
      between them is visible. A different white here would read as a flash at
      the very first frame — which is the failure this file exists to remove.
    -->
    <color name="zigly_splash_ground">#FFFFFF</color>
</resources>
